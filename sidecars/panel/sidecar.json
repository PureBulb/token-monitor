{
  "command": "node",
  "args": ["--max-old-space-size=32", "--optimize-for-size", "main.mjs"],
  "env": {
    "NODE_OPTIONS": "--max-old-space-size=32 --optimize-for-size"
  },
  "restart_policy": "always",
  "display_name": "Token 实时监控",
  "description": "实时监控消耗 Token、生成速度、缓存命中率及上下文长度",
  "has_web_ui": true,
  "ui_config": {
    "display_name": "Token 实时监控",
    "views": [
      {
        "path": "/",
        "entrypoint": "SIDECAR_UI_ENTRYPOINT_AUX_PANE",
        "title": "Token 实时监控"
      }
    ]
  }
}
